@import "../../styles/decision.wxss";
.home-page button.offer-entry, .home-page button.scenario-entry { width: 100%; max-width: none; margin-left: 0; margin-right: 0; }
.home-page button.about-link { width: auto; margin: 0; }
.home-page button.habits-entry { display: flex; align-items: center; width: 100%; min-height: 80px; margin: 24px 0 0; padding: 16px; background: var(--surface-raised); border: 1px solid var(--border-light); border-radius: 12px; text-align: left; white-space: normal; line-height: 1.5; }
.home-page { padding: 24px 24px calc(24px + env(safe-area-inset-bottom)); }
.home-heading { color: var(--text-primary); font-size: 28px; font-weight: 650; line-height: 1.3; letter-spacing: -0.02em; }
.home-intro { margin-top: 8px; color: var(--text-secondary); font-size: 16px; }
.offer-entry { display: block; box-sizing: border-box; width: 100%; margin: 24px 0 0; padding: 24px; border: 0; border-radius: 12px; background: var(--accent); color: #fff; text-align: left; white-space: normal; line-height: 1.5; }
.offer-label { font-size: 14px; font-weight: 600; }
.offer-title { margin-top: 12px; font-size: 28px; font-weight: 650; line-height: 1.3; letter-spacing: -0.02em; }
.offer-description { margin-top: 12px; font-size: 14px; }
.offer-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; font-size: 16px; font-weight: 600; }
.offer-arrow { font-size: 24px; line-height: 1; }
.offer-pressed { background: var(--accent-strong); }
.other-heading { margin-top: 32px; color: var(--text-secondary); font-size: 14px; font-weight: 400; }
.scenario-entry { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-height: 96px; margin: 0; padding: 20px 0; border-radius: 0; border-bottom: 1px solid var(--border-light); background: transparent; text-align: left; white-space: normal; line-height: 1.5; }
.entry-copy { flex: 1; min-width: 0; }
.entry-heading { color: var(--text-primary); font-size: 17px; font-weight: 650; }
.entry-description { margin-top: 4px; color: var(--text-secondary); font-size: 14px; }
.entry-arrow { flex: none; margin-left: 12px; color: var(--text-secondary); font-size: 24px; }
.draft-note { display: block; margin-top: 8px; color: var(--accent-strong); font-size: 14px; }
.entry-pressed { background: var(--surface-muted); }
.home-footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
.privacy-note { color: var(--text-secondary); font-size: 12px; }
.about-link { display: flex; align-items: center; gap: 8px; min-height: 48px; margin: 0; padding: 8px 0 8px 8px; background: transparent; color: var(--text-secondary); font-size: 12px; line-height: 1.5; }
@media (max-width: 350px) {
  .home-page { padding-right: 16px; padding-left: 16px; }
  .offer-entry { padding: 20px; }
}
