@import "../../styles/decision.wxss";
.home-page button.offer-entry, .home-page button.scenario-entry { width: 100%; max-width: none; margin-left: 0; margin-right: 0; }
.home-page button.about-link { width: auto; margin: 0; }
.home-page { padding: 24px 24px calc(24px + env(safe-area-inset-bottom)); }
.home-heading { color: var(--text-primary); font-size: 28px; font-weight: 650; line-height: 1.3; letter-spacing: -0.02em; }
.home-intro { margin-top: 8px; color: var(--text-secondary); font-size: 16px; }

/* ===== v2: 渐变主卡片 ===== */
.offer-entry { display: block; box-sizing: border-box; width: 100%; margin: 24px 0 0; padding: 24px; border: 0; border-radius: 16px; background: var(--accent-gradient); color: #fff; text-align: left; white-space: normal; line-height: 1.5; box-shadow: var(--shadow-accent); transition: transform var(--transition-fast); }
.offer-label { font-size: 13px; font-weight: 600; opacity: 0.85; }
.offer-title { margin-top: 12px; font-size: 26px; font-weight: 650; line-height: 1.3; letter-spacing: -0.02em; }
.offer-description { margin-top: 12px; font-size: 14px; opacity: 0.9; }
.offer-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; font-size: 15px; font-weight: 600; }
.offer-arrow { font-size: 22px; line-height: 1; }
.offer-pressed { transform: scale(0.98); opacity: 0.92; }

.other-heading { margin-top: 32px; color: var(--text-muted); font-size: 13px; font-weight: 600; }

/* ===== v2: 场景卡片（图标 + 内容 + 箭头） ===== */
.scenario-entry { display: flex; align-items: center; gap: 14px; box-sizing: border-box; width: 100%; min-height: 96px; margin: 12px 0 0; padding: 18px; border: 1px solid var(--border-light); border-radius: 12px; background: var(--surface-raised); box-shadow: var(--shadow-sm); text-align: left; white-space: normal; line-height: 1.5; transition: transform var(--transition-fast); }
.entry-icon { width: 44px; height: 44px; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 10px; font-size: 20px; }
.entry-icon-rent { background: #eef4ff; }
.entry-icon-budget { background: #fff7e8; }
.entry-icon-study, .entry-icon-purchase, .entry-icon-city, .entry-icon-side { background: var(--accent-soft); color: var(--accent-strong); }
.entry-symbol { position: relative; box-sizing: border-box; width: 22px; height: 20px; border: 2px solid currentColor; border-radius: 2px; }
.symbol-study::after { content: ""; position: absolute; top: -2px; bottom: -2px; left: 8px; border-left: 1px solid currentColor; }
.symbol-purchase { height: 18px; border-radius: 3px; }
.symbol-purchase::after { content: ""; position: absolute; top: 4px; left: 0; right: 0; border-top: 2px solid currentColor; }
.symbol-city { width: 14px; height: 24px; margin-right: 8px; border-radius: 1px; }
.symbol-city::after { content: ""; position: absolute; left: 14px; bottom: -2px; width: 6px; height: 14px; border: 2px solid currentColor; border-radius: 1px; }
.symbol-side { height: 16px; margin-top: 4px; border-radius: 3px; }
.symbol-side::after { content: ""; position: absolute; left: 4px; top: -7px; width: 8px; height: 4px; border: 2px solid currentColor; border-bottom: 0; border-radius: 3px 3px 0 0; }
.entry-copy { flex: 1; min-width: 0; }
.entry-heading { color: var(--text-primary); font-size: 16px; font-weight: 650; }
.entry-description { margin-top: 3px; color: var(--text-secondary); font-size: 13px; }
.entry-arrow { flex: none; margin-left: 4px; color: var(--text-muted); font-size: 20px; }
.draft-note { display: inline-block; margin-top: 6px; color: var(--accent-strong); font-size: 12px; font-weight: 600; }
.entry-pressed { transform: scale(0.98); background: var(--surface-muted); }
.home-page button.check-entry { display: flex; align-items: center; justify-content: space-between; gap: 12px; box-sizing: border-box; width: 100%; max-width: none; min-height: 88px; margin: 24px 0 0; padding: 16px 0; border-top: 1px solid var(--border-light); border-radius: 0; background: transparent; text-align: left; white-space: normal; line-height: 1.5; }
.check-entry .entry-description { color: #526178; }

.home-footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
.privacy-note { color: var(--text-muted); font-size: 12px; }
.about-link { display: flex; align-items: center; gap: 8px; min-height: 48px; margin: 0; padding: 8px 0 8px 8px; background: transparent; color: var(--text-secondary); font-size: 12px; line-height: 1.5; }

@media (max-width: 350px) {
  .home-page { padding-right: 16px; padding-left: 16px; }
  .offer-entry { padding: 20px; }
  .scenario-entry { padding: 14px; gap: 10px; }
}
