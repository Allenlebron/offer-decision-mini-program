.decision-shell { box-sizing: border-box; max-width: 640px; margin: 0 auto; padding: 24px 16px calc(32px + env(safe-area-inset-bottom)); overflow-wrap: anywhere; }
.decision-title { font-size: 28px; font-weight: 650; line-height: 1.24; letter-spacing: -0.02em; }
.decision-subtitle { font-size: 17px; font-weight: 650; line-height: 1.35; }
.decision-muted { color: var(--text-secondary); line-height: 1.6; }
.decision-link { display: flex; align-items: center; justify-content: center; min-height: 48px; margin: 0; padding: 8px 12px; background: transparent; color: var(--accent-strong); font-size: 16px; line-height: 1.5; white-space: normal; border-radius: 8px; }
.decision-primary, .decision-secondary { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-width: 0; min-height: 52px; width: 100%; margin: 0; padding: 12px 16px; border-radius: 8px; font-size: 16px; line-height: 1.5; font-weight: 650; white-space: normal; }
.decision-primary { background: var(--accent); color: #fff; }
.decision-secondary { background: var(--surface-muted); color: var(--text-primary); }
.decision-pressed { opacity: 0.75; }
.decision-primary[disabled] { background: var(--surface-muted); color: var(--text-secondary); }
.decision-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.decision-local { color: var(--text-secondary); font-size: 14px; }
.decision-notice { margin: 12px 0; padding: 12px; background: var(--accent-soft); color: var(--text-primary); border-radius: 8px; font-size: 14px; line-height: 1.6; }
.decision-error { color: var(--danger); font-size: 14px; margin-top: 8px; }
.decision-section { margin-top: 32px; }
.decision-section > .decision-subtitle { margin-bottom: 12px; }
.decision-paragraph { display: block; margin-top: 12px; line-height: 1.65; }
.decision-actions { display: flex; gap: 12px; }
.decision-actions > button { flex: 1; }

/* Outrank the native style:v2 button width and horizontal margins. */
.decision-shell button.decision-primary,
.decision-shell button.decision-secondary { width: 100%; max-width: none; margin-left: 0; margin-right: 0; }
.decision-shell button.decision-link { width: auto; margin-left: 0; margin-right: 0; }
.decision-shell .decision-actions > button { width: 0; flex: 1 1 0; }
